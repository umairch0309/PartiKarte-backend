<%- include('include/head.ejs', { subject: subject, logoUrl: typeof logoUrl !== 'undefined' ? logoUrl : 'cid:partikarte-logo' }) %>
                  <tr>
                    <td align="center" style="padding-bottom:8px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#3d8aff;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;">
                      Verification
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:16px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#0e2d5d;font-size:24px;font-weight:700;line-height:1.3;">
                      Email Verification Code
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:20px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#5b6b86;font-size:15px;line-height:1.6;">
                      Use the following One-Time Password (OTP) to verify your email address:
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:20px;">
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="background-color:#eaf2ff;border-radius:12px;margin:0 auto;">
                        <tr>
                          <td align="center" style="padding:18px 28px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#3d8aff;font-size:36px;font-weight:700;letter-spacing:8px;line-height:1.2;">
                            <%= otp %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:12px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#1d1e25;font-size:14px;line-height:1.6;">
                      This code will expire at <strong style="color:#0e2d5d;"><%= typeof otpExpiryFormatted !== 'undefined' && otpExpiryFormatted ? otpExpiryFormatted : '5 minutes' %></strong>.
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:8px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#5b6b86;font-size:13px;line-height:1.6;">
                      Please do not share this code with anyone.
                    </td>
                  </tr>
<%- include('include/footer.ejs') %>
