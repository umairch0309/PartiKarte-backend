<%- include('include/head.ejs', { subject: subject })%>
<table
  align="center"
  border="0"
  cellpadding="0"
  cellspacing="0"
  class="row row-3"
  role="presentation"
  style="
    mso-table-lspace: 0pt;
    mso-table-rspace: 0pt;
    background-color: #0187dd;
    background-size: auto;
  "
  width="100%"
>
  <tbody>
    <tr>
      <td>
        <table
          align="center"
          border="0"
          cellpadding="0"
          cellspacing="0"
          class="row-content stack"
          role="presentation"
          style="
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
            background-color: #fff;
            background-size: auto;
            color: #000;
            width: 600px;
            margin: 0 auto;
          "
          width="600"
        >
          <tbody>
            <tr>
              <td
                class="column column-1"
                style="
                  mso-table-lspace: 0pt;
                  mso-table-rspace: 0pt;
                  font-weight: 400;
                  text-align: left;
                  vertical-align: top;
                  border-top: 0px;
                  border-right: 0px;
                  border-bottom: 0px;
                  border-left: 0px;
                "
                width="100%"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  class="heading_block block-1"
                  role="presentation"
                  style="mso-table-lspace: 0pt; mso-table-rspace: 0pt"
                  width="100%"
                >
                  <tr>
                    <td
                      class="pad"
                      style="
                        padding-bottom: 5px;
                        padding-top: 25px;
                        text-align: center;
                        width: 100%;
                      "
                    >
                      <h1
                        style="
                          margin: 0;
                          color: #0187dd;
                          direction: ltr;
                          font-family: 'Lucida Sans Unicode', 'Lucida Grande',
                            'Lucida Sans', Geneva, Verdana, sans-serif;
                          font-size: 36px;
                          font-weight: normal;
                          letter-spacing: normal;
                          line-height: 120%;
                          text-align: center;
                          margin-top: 0;
                          margin-bottom: 0;
                        "
                      >
                        <strong>Tickets booked. Thank You!</strong>
                      </h1>
                    </td>
                  </tr>
                </table>
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  class="paragraph_block block-2"
                  role="presentation"
                  style="
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    word-break: break-word;
                  "
                  width="100%"
                >
                  <tr>
                    <td
                      class="pad"
                      style="
                        padding-bottom: 20px;
                        padding-left: 30px;
                        padding-right: 30px;
                        padding-top: 20px;
                      "
                    >
                      <div
                        style="
                          color: #737487;
                          font-family: Tahoma, Verdana, Segoe, sans-serif;
                          font-size: 18px;
                          line-height: 180%;
                          text-align: center;
                          mso-line-height-alt: 32.4px;
                        "
                      >
                        <p style="margin: 0; word-break: break-word">
                          <span>Dear <%= customerName %></span>
                        </p>

                        <p
                          style="
                            margin: 0;
                            margin-block: 10px;
                            word-break: break-word;
                          "
                        >
                          <span
                            >Thank you for booking tickets to <%= eventName %>.
                            We are thrilled to have you join us for this
                            exciting event. Your booking has been confirmed, and
                            we're looking forward to providing you with a
                            memorable experience.
                          </span>
                        </p>
                      </div>
                    </td>
                  </tr>
                </table>
                <tr>
                  <td
                    class="pad"
                    style="
                      padding-bottom: 20px;
                      padding-left: 30px;
                      padding-right: 30px;
                      padding-top: 20px;
                      font-family: Tahoma, Verdana, Segoe, sans-serif;
                      font-size: 13px;
                    "
                  >
                    <span>
                      For the latest updates, exclusive offers, and event
                      highlights, follow us on social media. We look forward to
                      seeing you at the event. Should you have any questions or
                      require further assistance, please feel free to reach out
                      to us.
                    </span>
                  </td>
                </tr>
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  class="button_block block-3"
                  role="presentation"
                  style="mso-table-lspace: 0pt; mso-table-rspace: 0pt"
                  width="100%"
                >
                  <tr>
                    <td
                      class="pad"
                      style="
                        padding-bottom: 30px;
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 20px;
                        text-align: center;
                      "
                    ></td>
                  </tr>
                </table>
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  class="image_block block-4"
                  role="presentation"
                  style="mso-table-lspace: 0pt; mso-table-rspace: 0pt"
                  width="100%"
                >
                  <tr>
                    <td class="pad" style="padding-bottom: 40px; width: 100%">
                      <div
                        align="center"
                        class="alignment"
                        style="line-height: 10px"
                      >
                        <img
                          alt="line"
                          src="https://partibucket.s3.eu-west-3.amazonaws.com/images/partikarte_data/divider.png"
                          style="
                            display: block;
                            height: auto;
                            border: 0;
                            max-width: 541px;
                            width: 100%;
                          "
                          title="line"
                          width="541"
                        />
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>
  </tbody>
</table>
<%- include('include/footer.ejs')%>
