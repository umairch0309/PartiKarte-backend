<%- include('include/head.ejs', { subject: subject, logoUrl: typeof logoUrl !== 'undefined' ? logoUrl : 'cid:partikarte-logo' }) %>
                  <tr>
                    <td align="center" style="padding-bottom:8px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#3d8aff;font-size:13px;font-weight:600;letter-spacing:0.4px;text-transform:uppercase;">
                      Contact
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:16px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#0e2d5d;font-size:24px;font-weight:700;line-height:1.3;">
                      New Contact Message
                    </td>
                  </tr>
                  <tr>
                    <td align="center" style="padding-bottom:20px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#5b6b86;font-size:15px;line-height:1.6;">
                      Partikarte received a new contact form submission.
                    </td>
                  </tr>
                  <tr>
                    <td align="left" style="padding:16px 18px;background-color:#eaf2ff;border-radius:12px;font-family:'Outfit',Arial,Helvetica,sans-serif;color:#1d1e25;font-size:14px;line-height:1.7;">
                      <strong style="color:#3d8aff;">First name:</strong> <%= firstName %><br />
                      <strong style="color:#3d8aff;">Last name:</strong> <%= lastName %><br />
                      <strong style="color:#3d8aff;">Email:</strong> <%= email %><br />
                      <strong style="color:#3d8aff;">Phone:</strong> <%= phoneNumber %><br />
                      <strong style="color:#3d8aff;">Subject:</strong> <%= object %><br />
                      <strong style="color:#3d8aff;">Message:</strong><br />
                      <%= description %>
                    </td>
                  </tr>
<%- include('include/footer.ejs') %>
